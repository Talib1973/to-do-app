# Database Configuration
# PostgreSQL connection string for Neon or local database
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/todoapp

# Authentication Secret
# MUST be at least 32 characters for JWT signing
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-replace-this-value

# API Configuration (optional, has defaults)
# API_PORT=8000
# API_HOST=0.0.0.0
# API_RELOAD=true
